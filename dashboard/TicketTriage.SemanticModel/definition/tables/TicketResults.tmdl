table TicketResults
	lineageTag: aca0e296-05eb-425b-b848-83e1d407c796

	measure Tickets = COUNTROWS('TicketResults')
		formatString: 0
		lineageTag: f07bb9bf-3d47-469c-9eca-ed6e77338f7a

	measure 'Category Accuracy' = DIVIDE(SUM('TicketResults'[CategoryOK]), [Tickets])
		formatString: 0%
		lineageTag: 54053f9d-b8c0-4882-ac23-963212695c10

	measure 'Priority Accuracy' = DIVIDE(SUM('TicketResults'[PriorityOK]), [Tickets])
		formatString: 0%
		lineageTag: 02558938-a1f8-4a1d-a495-e730551e6a7e

	measure 'Review Rate' = DIVIDE(SUM('TicketResults'[NeedsReview]), [Tickets])
		formatString: 0%
		lineageTag: 501399f1-14c1-444b-b47f-be941ba589fc

	measure 'Wrong Not Reviewed' = COALESCE(CALCULATE([Tickets], 'TicketResults'[CategoryOK] = 0, 'TicketResults'[NeedsReview] = 0), 0)
		formatString: 0
		lineageTag: 8fb89064-98fc-454c-911a-ca838af470d7

	measure 'Wrong Caught' = COALESCE(CALCULATE([Tickets], 'TicketResults'[CategoryOK] = 0, 'TicketResults'[NeedsReview] = 1), 0)
		formatString: 0
		lineageTag: dbb1737f-695d-4097-a82c-1db7ec0f8679

	measure 'Over-escalated' = COALESCE(CALCULATE([Tickets], 'TicketResults'[Priority Error] = "over-escalated"), 0)
		formatString: 0
		lineageTag: 39592dda-38f0-4da7-ad2a-f13933e6c59a

	measure 'Under-escalated' = COALESCE(CALCULATE([Tickets], 'TicketResults'[Priority Error] = "under-escalated"), 0)
		formatString: 0
		lineageTag: b60bbe6e-badd-4764-85cb-62e41d718016

	measure 'Tickets (current)' = CALCULATE([Tickets], 'TicketResults'[Run] = "3 · v2 run 2")
		formatString: 0
		lineageTag: 10a41ecf-8a88-489b-9bf8-7d77220879ff

	measure 'Category Accuracy (current)' = CALCULATE([Category Accuracy], 'TicketResults'[Run] = "3 · v2 run 2")
		formatString: 0%
		lineageTag: 1bc0d0be-cc37-4a1c-8b8a-b70eeeee1bea

	measure 'Priority Accuracy (current)' = CALCULATE([Priority Accuracy], 'TicketResults'[Run] = "3 · v2 run 2")
		formatString: 0%
		lineageTag: 8dbc826b-f7e3-4bd1-8d3e-f9baf3c1ba95

	measure 'Review Rate (current)' = CALCULATE([Review Rate], 'TicketResults'[Run] = "3 · v2 run 2")
		formatString: 0%
		lineageTag: 6790b101-4da0-4e7e-a2ee-3ad56cf16c6d

	measure 'Wrong Not Reviewed (current)' = CALCULATE([Wrong Not Reviewed], 'TicketResults'[Run] = "3 · v2 run 2")
		formatString: 0
		lineageTag: 23bc449a-6d20-456c-ab4e-88040877fc44

	measure 'Reviewed (current)' = VAR n = CALCULATE(SUM('TicketResults'[NeedsReview]), 'TicketResults'[Run] = "3 · v2 run 2") RETURN IF(n = 0, BLANK(), n)
		formatString: 0
		lineageTag: 7f173578-ab89-4c54-a6be-c599fc6e3a31

