	partition TicketResults = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Run", "Ticket", "Kind", "Expected Category", "Predicted Category", "CategoryOK", "Expected Priority", "Predicted Priority", "PriorityOK", "Priority Error", "Route", "NeedsReview", "Review Reason", "Outcome", "Problems", "Ticket Text"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Run", type text}, {"Ticket", type text}, {"Kind", type text}, {"Expected Category", type text}, {"Predicted Category", type text}, {"CategoryOK", Int64.Type}, {"Expected Priority", type text}, {"Predicted Priority", type text}, {"PriorityOK", Int64.Type}, {"Priority Error", type text}, {"Route", type text}, {"NeedsReview", Int64.Type}, {"Review Reason", type text}, {"Outcome", type text}, {"Problems", type text}, {"Ticket Text", type text}}, "en-US")
				in
				    Typed

